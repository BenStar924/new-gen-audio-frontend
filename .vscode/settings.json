{
  // CMake Tools would otherwise try to configure the moment the folder opens,
  // which fails noisily on Windows where the C application does not build.
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/build",

  "files.associations": {
    "*.h": "c"
  },
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src"
  ],

  // vendor/ is a built stylesheet and a pinned third-party bundle. Editing
  // either by hand is a mistake — app.css is regenerated by build-css.sh.
  "files.readonlyInclude": {
    "www/vendor/**": true
  },
  "search.exclude": {
    "build/**": true,
    "build-pi/**": true,
    "www/vendor/**": true
  }
}
